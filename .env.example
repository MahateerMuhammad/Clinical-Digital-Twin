# .env.example — copy to `.env` and fill in your key. `.env` is gitignored.
#
#   cp .env.example .env
#
# Every variable is optional. With none set the system still runs end to end:
# extraction falls back to deterministic patterns, the completeness gate, triage,
# retrieval, the risk models and the grounding checks never touch an LLM, and
# nothing leaves the machine. What you lose is the ability to read fourteen
# laboratory values out of one sentence — the assistant simply asks for more.

# ── Hosted LLM ──────────────────────────────────────────────────────────────
# Used in exactly two places: fact extraction from free clinical text, and the
# LLM-as-judge harness. Never for prediction, never for the gate, never for
# triage or evidence selection.
#
# Any OpenAI-compatible endpoint works — the base URL below is what selects the
# provider. Two configurations are known good; pick one, and keep the model and
# base URL together, because a model name from one provider sent to another
# returns 404.

# ── Option A: Google Gemini (the verified default) ──
# Key from https://aistudio.google.com/apikey
CDT_LLM_API_KEY=
CDT_OPENROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CDT_OPENROUTER_MODEL=gemini-3.7-flash
CDT_JUDGE_MODEL=gemini-3.5-flash
#
# Measured: 3.5s for a 61-field extraction prompt, 15/15 fields including the
# diagnosis. Free tier is 20 requests per day *per model*, which is why the
# judge is pinned to a different one — a transcript capture would otherwise
# spend the judge's allowance before it runs.
#
# Pinned, not `gemini-flash-latest`: an evaluation report names the model that
# produced it, and a floating alias silently changes what a saved score means.
# `gemini-flash-latest` is also an alias for 3.7 and shares its quota.
#
# `gemini-2.5-flash` and `gemini-2.5-flash-lite` appear in the model list and
# return 404 "no longer available to new users". Do not use them.

# ── Option B: OpenRouter ──
# Key from https://openrouter.ai/keys. To use, empty CDT_LLM_API_KEY above,
# set this one, and swap in the two commented lines.
OPENROUTER_API_KEY=
#CDT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#CDT_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#CDT_JUDGE_MODEL=openai/gpt-oss-20b:free
#
# Free tier is 50 model requests per day per *account* — shared across every
# `:free` model, so switching models does not reset it. 10 credits raises it to
# 1000/day. Worth knowing before a demo: one judge round is 20 requests and one
# transcript capture is ~32.

# Reasoning effort: off | low | medium | high.
#
# Off by default, and that is a correctness decision rather than a cost one. A
# reasoning model spends its *completion* budget thinking: at max_tokens=2048,
# nemotron used 1841 tokens reasoning about a fact-extraction prompt and had too
# few left to finish the JSON. The response came back cut mid-field, parsed as a
# failure, and extraction fell back to its deterministic floor silently on every
# turn. Neither extraction nor judging needs a chain of thought, and off is also
# roughly four times faster.
#
# Sent as `reasoning` to OpenRouter and `reasoning_effort` elsewhere; each host
# rejects the other spelling outright.
CDT_OPENROUTER_REASONING=off

# Request timeout, seconds. Extraction has a deterministic fallback, so a low
# value degrades gracefully rather than failing the turn.
CDT_OPENROUTER_TIMEOUT=30

# ── Local LLM (optional; no quota, and nothing leaves the machine) ───────────
# `ollama pull qwen2.5:3b-instruct`, then point the assistant at OllamaBackend.
# Extraction copies verbatim spans into fixed field names — a parsing task well
# within a 3B model, and sub-second locally.
CDT_LLM_MODEL=qwen2.5:3b-instruct

# ── Backend ─────────────────────────────────────────────────────────────────
# 1 attaches the gate decision, extraction proposals and faithfulness checks to
# every API response. Development only — spec 28 keeps the reasoning trace out
# of what the reader receives.
CDT_ASSISTANT_DEBUG=0

# Comma-separated origins allowed by CORS.
CDT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
