__pycache__/
*.py[cod]
*$py.class
.pytest_cache


# Virtual environments
.venv/
venv/
env/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp

# Project specific: Data, Models, and Logs
# NEVER push data or model binaries to the repository
#
# Anchored with a leading slash. Written as `data/` and `models/`, these patterns
# match a directory of that name at *any* depth — which silently excluded
# `src/data/` and `src/models/` from version control. Twelve source files, including
# the entire cleaning pipeline and every model-training module, were untracked and
# would have been lost on a fresh clone. The intent was always the top-level data and
# artifact directories; the leading slash is what actually says that.
/data/
/models/
/logs/
*.pkl
*.parquet
*.csv
*.csv.gz

# Images
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.bmp
*.tiff
*.ico
*.webp

# Interactive HTML plots
*.html

kaggle_bundle/


# Reports and generated assets
# You can uncomment these if you want to push reports, 
# but they are often large and autogenerated.
# reports/
# !reports/.gitkeep

# Temporary/test scripts
test_mixed.py

# Secrets
#
# `.env` was NOT covered before. The `env/` entry above matches a virtualenv
# directory, not the dotfile — so the first `.env` written with a real API key
# would have been committed. `.env.example` is deliberately re-included: it
# documents the variables and contains no values.
.env
.env.*
!.env.example

# frontend
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
# `*.html` above is aimed at generated report output; the app's entry point is
# source, and without this exception the frontend does not build from a clone.
!frontend/index.html

node_modules/
